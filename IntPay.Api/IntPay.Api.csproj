<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
  	  <PackageReference Include="Scalar.AspNetCore" Version="2.11.1" />
  	  <PackageReference Include="Supabase" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <!-- Test project lives under repo folder but must not compile into the web app -->
  <ItemGroup>
    <Compile Remove="IntPay.Api.Tests/**" />
    <None Include="IntPay.Api.Tests/**" />
  </ItemGroup>

</Project>
